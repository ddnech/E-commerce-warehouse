# Copy this file to .env and change what you need:
#   cp .env.example .env
# Docker works fine without a .env file too, these are the same defaults it uses.

# ---- Ports on your machine ----
# These don't clash with the Online Library or Attendance projects.
# the shop (Docker)
CLIENT_PORT=3200
# the Express API
API_PORT=8200
# MySQL
DB_PORT=3309
# inbox for test emails
MAILPIT_PORT=8027

# ---- Time zone ----
APP_TIMEZONE=Asia/Jakarta

# ---- Database ----
DB_NAME=furnifor
DB_USER=furnifor
DB_PASSWORD=furnifor
DB_ROOT_PASSWORD=root
# Only used when you run the API outside Docker (npm run dev). Docker uses "db".
DB_HOST=127.0.0.1

# ---- Login tokens ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-something-long-and-random
USER_TOKEN_EXPIRES_IN=7d
ADMIN_TOKEN_EXPIRES_IN=12h

# ---- Links in emails ----
# Where "confirm your email" and "reset password" links point.
# APP_URL is for npm run dev, DOCKER_APP_URL is for Docker.
APP_URL=http://localhost:5175
DOCKER_APP_URL=http://localhost:3200

# ---- Shop rules ----
# Unpaid orders are cancelled after this many hours.
PAYMENT_WINDOW_HOURS=24
# Shipped orders count as delivered after this many days if the customer doesn't confirm.
AUTO_COMPLETE_DAYS=7
# Shown to customers on the payment page.
BANK_ACCOUNT=BCA 123 456 7890 a.n. PT Furnifor Indonesia

# ---- Demo data ----
# 5 warehouses, 40 products, customers and orders in every status.
# Roles, provinces, cities and the super admin are always added.
SEED_DEMO_DATA=true

# ---- Optional API keys ----
# Leave any of these empty and the app still works, it just uses a simpler built-in version.

# Real JNE / POS / TIKI shipping prices. Without it, prices are estimated from distance and weight.
# Get a key at https://collaborator.komerce.id (RajaOngkir by Komerce).
RAJAONGKIR_API_KEY=

# Exact map position for addresses. Without it, the centre of the city is used.
# Free key at https://opencagedata.com
OPENCAGE_API_KEY=

# "Continue with Google" button. Without it, the button is hidden.
# Create an OAuth client (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add http://localhost:3200 and http://localhost:5175 as authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# ---- Email ----
# By default emails go to Mailpit (http://localhost:8027), nothing is really sent.
# These two are used when you run the API outside Docker:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# To send real email (Gmail example, needs an App Password), set these and the two Docker ones:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#   DOCKER_SMTP_HOST=smtp.gmail.com   DOCKER_SMTP_PORT=465
# For Gmail, SMTP_USER is your full Gmail address and SMTP_PASSWORD is the 16 character App Password.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Furnifor <no-reply@furnifor.local>
